fit <- lmFit(tempeset, design);
ebayes <- eBayes(fit);
sortebays <- sort.int(ebayes$t[,2], decreasing = TRUE, index.return = TRUE);
sortebays1 <- ebayes[sortebays$ix,];
save(sortebays1, file = paste(teamp1,c(".RData"),sep=""));
