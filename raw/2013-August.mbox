> treatment <- gl(2,2,8)
> timepoint <- gl(2,1,8)
> Treat.Time <- factor(paste(treatment,timepoint,sep="."))
> design <- model.matrix(~0+Treat.Time+Subject)
> colnames(design)[1:4] <- levels(Treat.Time)
