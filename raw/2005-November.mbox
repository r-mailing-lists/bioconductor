4634                 lysU_b4129_st  3.40  9.8  11.6  0.0364 2.00
4901                 oppB_b1244_st  2.73 10.7  11.6  0.0364 1.98
> fit22 <- eBayes(fit2[!i,])
> topTable(fit22)
                                ID     M    A     t P.Value    B
5335                 serA_b2913_st -3.07 12.1 -15.8  0.0362 2.77
1379                 gltB_b3212_st -3.06 10.4 -14.4  0.0362 2.56
