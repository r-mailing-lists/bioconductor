colnames(Counts) <- c("label perm", "gene perm")

for (i in 1:length(universe)) {

        Counts[i,1] <- universe[i] %in% set1

        Counts[i,2] <- universe[i] %in% set2

}

jpeg("venn1.jpg")

vennDiagram(vennCounts(Counts))

dev.off()

