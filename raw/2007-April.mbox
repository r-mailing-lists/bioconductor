    [43] "YNL145W" "YNL271C" "YNL283C" "YNR031C" "YOL105C" "YOR008C" "YOR212W"
    [50] "YOR231W" "YPL049C" "YPL089C" "YPL140C" "YPL187W" "YPR165W"

To get the category to _selected_ gene IDs mapping:

    > geneIdsByCategory(ans)[1:2]
    $`00625`
    [1] "YOR120W"
    
    $`04010`
