ends    <- starts+20
strands <- c("+","-","+")

myViews <- Views(x, start=starts, end=ends)
names(myViews) <- names

revViews <- reverseComplement(myViews[strands=="-"])
posViews <- myViews[strands=="+"]


Many thanks,

