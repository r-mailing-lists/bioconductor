> > m
>      [,1] [,2]
> [1,]   -2    2
> [2,]   -1    3
> [3,]    0    4
> [4,]    1    5
> > m[m < 0] <- 0
> > m
>      [,1] [,2]
> [1,]    0    2
> [2,]    0    3
> [3,]    0    4
