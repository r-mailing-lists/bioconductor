>>>>>     [[1]] character(0)
>>>>>     [[2]] rs75258394 rs78180314
>>>>>     [[3]] rs72619361
>>>>>     [[4]] rs3087742
>>>>>     [[5]] rs76676778
>>>>>     [[6]] rs6518357
>>>>>
