    NA    NA    NA    NA    NA
> library(GenomicFeatures)
> hg18.txdb = loadFeatures("hg18.txdb.sqlite")
> tx18 = transcripts(hg18.txdb)
> kg = values(tx18[ findOverlaps(kem,tx18)@matchMatrix[,2] ])$tx_name
> dput(kg)
