        cbind(as.numeric(myAnova[,3][2:4]),as.numeric(myAnova[,4][2:4]))
    }
   
    ta<-function(){esApply(eset,1,lmePvals)}
   
    lmeOutput<-t(ta())
    dimnames(lmeOutput)[[2]]<-c("F Treatment", "F Genotype", "F 
Interaction",
                                "p Treatment", "p Genotype", "p 
Interaction")
   
    lmeOutput
   

