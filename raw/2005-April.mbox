Try try():

distances<-numeric(100)
for (i in 1:100){
 goanal <- try(simLL(as.character(hmapr$V1[i]),as.character(hmapr$V2[i]),"MF"))
 if (inherits(gonal, "try-error")) {
     goanal <- list()
     goanal[["sim"]] <- NA
  print(goanal$sim)
 distances[i]<-goanal$sim
 rm(goanal)
 }

+ seth

