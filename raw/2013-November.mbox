>>> my.SE.noCpgSnps.onlyCpGs <- my.SE.noCpgSNPs[which(substr(rownames(my.SE.noCpgSNPs),1,2)== 'cg') , ] 
>>> dim(my.SE.noCpgSnps.onlyCpGs)
>>> ## [1] 465130     11
