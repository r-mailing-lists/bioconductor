object.type, ...)
+		check <- clusterApply(cluster, object.list, .initAffyBatchSF, 
object.type, cdfname = cdfname, ...)
  		t1 <- proc.time();
  	if (verbose) cat(round(t1[3]-t0[3],3),"sec DONE\n")
  	

