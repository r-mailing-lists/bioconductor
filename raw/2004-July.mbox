> >ll.chr <- tapply(chr, ll, unique)
> Error in unique.default(X[[as.integer(1)]], ...) :
>         unique() applies only to vectors
> >ll.chr <- tapply(unlist(chr), ll, unique)
> Error in tapply(unlist(chr), ll, unique) :
