thanks everybody. this made it much faster:

tmpseq <- DNAString(pmseq)
GC <- DNAString("GC")
CG <- DNAString("CG")
tmp <- sapply(1:length(tmpseq),function(i){
  y=tmpseq[i]
  c(alphabetFrequency(y)[2:5],
    length(matchDNAPattern(GC,y)),
    length(matchDNAPattern(CG,y)))
})

