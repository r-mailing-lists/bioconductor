boxplot(AveSignal~ qual)

rem <- qual == "No match" | qual == "Bad"

maqc.norm.filt <- maqc.norm[unlist(mget(names(qual)[!rem],
illuminaHumanv2ARRAYADDRESS)),]

Sorry for the inconvenience,

