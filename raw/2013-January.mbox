> contrast.matrix<-makeContrasts(affected-Healthy,levels = design)
> fit2<- contrasts.fit(fit, contrast.matrix)
> fit2<- eBayes(fit2)
> topTable(fit2,coef=1,p=0.05, adjust="fdr")
> results<- decideTests(fit2, adjust="fdr", p=0.05)
