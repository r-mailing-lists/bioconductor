## now a simple SQL query

 > dbGetQuery(con, paste("select chrom, physical_pos, allele_a, allele_b 
from featureSet where man_fsetid in ('", paste(ids[,1], collapse="','"), 
"');", sep = ""))
    chrom physical_pos allele_a allele_b
1      1      2224111        A        G
