RG <- read.maimages(targets$Filename, 
        source = "genepix", 
        columns = columns) 
spottypes <- readSpotTypes()
RG$genes$Status<-controlStatus(spottypes,RG)
RG <- RG[RG$genes$Status != "blank",]

