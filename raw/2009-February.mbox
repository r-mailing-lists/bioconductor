   mapped_genes <- mappedkeys(x)
   # Convert to a list
   xx <- as.list(x[mapped_genes])
   eids <- ''

   ENTREZID2GENESYMBOL <- matrix(0,length(xx),2)
   colnames(ENTREZID2GENESYMBOL) <- c('ENTREZ_IDS','GENE_SYMBOLS')
