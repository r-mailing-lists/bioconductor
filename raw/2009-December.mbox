> > > > > > par(mfrow=c(1,5))
> > > > > > for(i in 1:5) {
> > > > > >        image(scale(t(imp[rev(index[i,]), ])), col=redgreen(75),
> > > > xaxt="n",
> > > > > > yaxt="n", main=i)
> > > > > > }
> > > > > >
