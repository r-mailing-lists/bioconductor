>> m<-matchPatterns('CTAG', c1)
>>
>> #And the for loop
>> reslt<-NULL
>> for (i in 1:(length(m)-1)) {
>>    reslt<-rbind(reslt, cbind(start(m[i])+1, start(m[i+1])-3,
