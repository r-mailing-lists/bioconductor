> makeProbePackage( "AFLAVUSa520391F" ,
>                   datafile   = filename ,
>                   outdir     = outdir ,
>                   species    = species ,
>                   maintainer = me ,
>                   version    = '0.0.1' ,
>                   force      = TRUE )
> ---------------------8<-----------------------------------------
