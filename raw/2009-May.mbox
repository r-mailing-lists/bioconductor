You can use the cor() function like this:

## Some example data set
y <- matrix(rnorm(50), 10, 5, dimnames=list(paste("g", 1:10, sep=""), paste("t", 1:5, sep="")))

## Create correlation matrix
c <- cor(t(y), method="spearman"); 

## Convert to distances
d <- as.dist(1-c)


