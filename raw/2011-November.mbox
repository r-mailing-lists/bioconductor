patient = factor(rep(1:6, each=2))
design <- model.matrix(~patient+d$samples$group)
rownames(design) <- rownames(d$samples)
colnames(design)[7] <- "Cancer"

# calculate 
d <- estimateGLMCommonDisp(d, design)


