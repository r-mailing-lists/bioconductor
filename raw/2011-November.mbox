> starts
> ? ? ? ?tmp.end<-end(subject(tmp.align)) ? ? ? ? ? ? ? ? ? ? ? ? ? ? ? ? ? ? ? ? ? ? ? ? ? ? ? ? ? ? ? ? ? ? ? ? ? ? ? ? ? ? ? ?# vector of all alignment ends
>
