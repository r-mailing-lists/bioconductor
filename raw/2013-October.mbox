> Treat <- factor(paste(targets$Condition,targets$Time,sep="."))
> design <- model.matrix(~0+Treat)
> colnames(design) <- levels(Treat)
> colnames(design)
> [1] "Case.Time2"    "Case.Time1"     "Control.Time2" "Control.Time1"
>
