>                  ux_group <- ux_group[keep_idx]
>                  ux_id <- ux_id[keep_idx]
>                  sm <- IRanges:::__selfmatchIntegerPairs(ux___group, ux_id)
>                  keep_idx <- sm == seq_along(sm)
>                  ux <- ux[keep_idx]
>                  ux_group <- ux_group[keep_idx]
