[3,]  0 -1  0
[4,] -1  0  1
[5,]  0  0  1
[6,]  1 -1  0
[7,]  0  1  0
[8,]  1  0 -1
 > 
contrast.matrix<-makeContrasts("wt_WT"=wt,"mu_MU"=mu-MU,"(mu_MU)_(wt_WT)"=(mu-MU)-wt,levels=design)
