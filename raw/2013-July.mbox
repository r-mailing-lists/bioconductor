    fiveUTRs <- unique(unlist(fiveUTRsByTranscript(TranscriptDb)))
    threeUTRs <- unique(unlist(threeUTRsByTranscript(TranscriptDb)))
    transcripts <- transcripts(TranscriptDb, columns=NULL)


