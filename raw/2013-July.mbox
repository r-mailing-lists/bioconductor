>> select(org.Hs.eg.db, rep("ADORA2A", 4), "ENTREZID", "ALIAS")
>      ALIAS ENTREZID
> 1 ADORA2A      135
> 2 ADORA2A      135
> 3 ADORA2A      135
> 4 ADORA2A      135
>
>> select(org.Hs.eg.db, rep("AGT", 4), "ENTREZID", "ALIAS")
>    ALIAS ENTREZID
> 1   AGT      183
> 2   AGT      189
