>>>>
>>>> ## start
>>>> pkgs = c("oligo", "pd.hg18.60mer.expr", "maqcExpression4plex",
>>>> "genefilter", "limma", "RColorBrewer")
>>>> source("http://www.bioconductor.org/biocLite.R")
