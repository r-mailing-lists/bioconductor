         retval$colMeans <- rm <- colMeans(x, na.rm = na.rm)
         x <- sweep(x, 2, rm)
         retval$colSDs <- sx <- apply(x, 2, sd, na.rm = na.rm)
         x <- sweep(x, 2, sx, "/")
     }

