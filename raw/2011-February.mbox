>             df$Term <- character(0)
>             return(df)
>         }
>         pfamIds <- df[[1]]
>         if (htmlLinks) {
>             pfamIdUrls <- sapply(pfamIds, function(x) sprintf(PFAM_URL,
>                 x))
>             pfamTerms <- paste("<a href=\"", pfamIdUrls, "\">",
>                 pfamIds, "</a>", sep = "")
>         }
>         else {
>             pfamTerms <- pfamIds
>         }
