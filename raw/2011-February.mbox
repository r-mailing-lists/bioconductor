> Function: summary (package base)
> object="PFAMHyperGResult"
> function (object, ...)
> {
>     .local <- function (object, pvalue = pvalueCutoff(object),
>         categorySize = NULL, htmlLinks = FALSE)
>     {
>         PFAM_URL <- "http://www.sanger.ac.uk/cgi-bin/Pfam/getacc?%s"
