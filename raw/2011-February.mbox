just do

code:
 design <- model.matrix(~factor(rep(1:2, each=3)))
 fit <- lmFit(eset, design)
 fit2 <- eBayes(fit)
top.list<-topTable(fit2,coef=2,adjust="BH")
your.results <- top.list[top.list$adj.P.Val < 0.05, ]

...it should do the trick...

