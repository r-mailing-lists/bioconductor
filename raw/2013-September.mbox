>>>> head(fData(ecS)$dispBeforeSharing)
>>>>
>>>> ecS <- testForDEU(ecS)
>>>> head(fData(ecS)[, c("pvalue", "padjust")])
>>>> ecS <- estimatelog2FoldChanges(ecS, averageOutExpression=FALSE)
>>>> res2 <- DEUresultTable(ecS)
>>>> sum(ecS$pad
>>>>
