  [5,] "A"  "P"  "P"  "P"  "P"
  [6,] "M"  "P"  "M"  "M"  "M"
  [7,] "A"  "M"  "P"  "M"  "A"
  [8,] "A"  "P"  "P"  "P"  "A"
