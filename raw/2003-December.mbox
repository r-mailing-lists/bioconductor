What about:

## example data: swirl
data(swirl)

getRfprinttip <- function(x, tip) {
  z <- maPrintTip(x)
  if (tip > max(z))
    stop("Tip number too high.")
  r <- maRf(x)[z == tip]
  return(r)
}

## values for print-tip #2
tmp <- getRfprinttip(swirl, 2)


