Erik,

This is much faster:

   countLeadingLetter2 <- function(x, letter="-")
   {
     ans <- which(!isMatchingAt(letter, x, seq_len(length(x))))[1L]
     if (is.na(ans))
         return(length(x))
     ans - 1L
   }

   countTrailingLetter2 <- function(x, letter="-")
     countLeadingLetter2(reverse(x), letter=letter)

Cheers,
H.

