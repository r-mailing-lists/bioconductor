ref250B[,,2] <- senseThetaB(snprma250ref)

# Reference B: rowMeans over sense and antisense strand
refB <- sapply(1:dim(ref250B)[2],function(x)rowMeans(ref250B[,x,],na.rm=T))
colnames(refB) <- colnames(ref250B)

# Sample for allele A:
# allele A as array
