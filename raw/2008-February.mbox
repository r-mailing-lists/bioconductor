>>> fit.noref2= contrasts.fit(fit.noref, cont.matrix)
>>> fit.noref2=eBayes(fit.noref2)
>>> summary(topTable(fit.noref2,n=10000)$adj.P.Val<=0.05)
>>
>>         ---> I get 3668 differentially expressed spots.
