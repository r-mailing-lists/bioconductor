This is a trivial one-liner:

r = data.frame(Start=c(1,5,13), End=c(3,9,15))
g = data.frame(Gene=c(1,2,3,4), Position=c(14,4,10,6))

index = apply(g, 1, function(x) any(x[2]>=r$Start & x[2]<=r$End))

