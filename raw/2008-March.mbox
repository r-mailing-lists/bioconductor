>
> data("Dilution")
>
> a1 = Dilution[, 1:3]
> a2 = Dilution[, 4  ]
>
> refvsn = vsn2(a1)
> x1 = predict(refvsn, a1)
>
> x2 = justvsn(a2, ref=refvsn)
>
> x = justvsn(Dilution)
> par(mfrow=c(2,2))
> for(i in 1:4)
>   plot(exprs(x)[,i],
>        if(i<=3) exprs(x1)[,i] else exprs(x2)[,1],
>        pch=".")
>
>
>
