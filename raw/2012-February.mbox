     ...      ...                  ...    ... ...                       ...
[37916]     chrY [27177050, 27198251]      -   |                      9083
[37917]     chrY [27177050, 27198251]      -   |                    442867
[37918]     chrY [27177050, 27198251]      -   |                    442868
